{
    "name": "psiccamilamelissa",
    "version": "1.0.0",
    "type": "module",
    "description": "site/aplicação para divulgação e prestação de serviços da psicologa Camila Melissa de Souza",
    "scripts": {
        "dev": "parcel index.html --port 3000 --no-cache",
        "start": "parcel index.html --open --port 3000 --no-cache",
        "build": "parcel build index.html --dist-dir build --public-url ./",
        "clean": "rm -rf dist .parcel-cache",
        "stop": "pkill -f 'parcel.*index.html' 2>/dev/null; exit 0",
        "restart": "npm run stop && npm run clean && npm run dev",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RudeBoyOne/psiccamilamelissa.git"
    },
    "keywords": [
        "site",
        "aplicação",
        "psicologa",
        "serviços",
        "terapia"
    ],
    "author": "Lucas Ferreira Nogueira",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/RudeBoyOne/psiccamilamelissa/issues"
    },
    "homepage": "https://github.com/RudeBoyOne/psiccamilamelissa#readme",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@parcel/packager-raw-url": "^2.13.3",
        "@parcel/transformer-jsonld": "^2.13.3",
        "@types/node": "^26.0.1",
        "buffer": "^6.0.3",
        "eslint": "^10.6.0",
        "globals": "^17.7.0",
        "parcel": "^2.13.3",
        "postcss": "^8.5.16",
        "process": "^0.11.10",
        "svgo": "^3.3.2",
        "tailwindcss": "^3.4.19",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.1"
    },
    "dependencies": {
        "bootstrap-icons": "^1.11.3",
        "lit": "^3.3.3",
        "lucide": "^1.22.0",
        "pdfjs-dist": "^4.10.38"
    }
}
