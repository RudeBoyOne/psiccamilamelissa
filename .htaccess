<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Força HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Remove www (redireciona www para não-www)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Redireciona /home para /
  RewriteRule ^home/?$ / [R=301,L]

  # Redireciona antigas rotas SPA para a landing page
  RewriteRule ^about/?$ / [R=301,L]
  RewriteRule ^articles/?$ / [R=301,L]
  RewriteRule ^contact/?$ / [R=301,L]

  # display_pdf continua acessível (é uma página real servida pelo JS)
  RewriteRule ^display_pdf/?$ - [L]
</IfModule>
